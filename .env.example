# All optional - set in the Render dashboard (Environment tab).
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3-flash-preview
# Upstream wisp servers (comma separated). Private to the backend.
# WISP_UPSTREAMS=wss://one.example/wisp/,wss://two.example/
# WISP_CHECK_INTERVAL_MS=30000
# MAX_WISP_CLIENTS=400
# Games are fetched from GitHub on first play and cached on disk.
# GAMES_CACHE_MB=1500
# GAMES_CACHE_DIR=/tmp/liquidform-games
